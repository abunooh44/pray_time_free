<Window x:Class="PrayTime.App.Views.PreIqamaWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="استعد للصلاة"
        Width="440"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource F.Ui}"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <Border Margin="14"
            Padding="30,26"
            Background="{DynamicResource B.Surface}"
            BorderBrush="{DynamicResource B.Gold}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              Opacity="0.6"
                              ShadowDepth="5"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="HeaderText"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Gold}"
                       Style="{StaticResource T.Base}"
                       Text="حان وقت الاستعداد للصلاة" />

            <TextBlock x:Name="DetailText"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource T.Dim}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="CountdownText"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center"
                       FontSize="46"
                       FontWeight="SemiBold"
                       Style="{StaticResource T.Numeric}"
                       Text="00" />

            <TextBlock Margin="0,2,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource T.Faint}"
                       Text="ثانية" />

            <TextBlock x:Name="HintText"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource T.Faint}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="احفظ عملك الآن — لا يمكن تأجيل هذا الإجراء." />

            <Button x:Name="BtnNow"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Stretch"
                    Click="OnNowClick"
                    Content="اقفل الآن"
                    Style="{StaticResource Btn.Primary}" />
        </StackPanel>
    </Border>
</Window>

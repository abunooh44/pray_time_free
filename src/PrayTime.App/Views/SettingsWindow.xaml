<Window x:Class="PrayTime.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات مواقيت"
        Width="620"
        Height="720"
        MinWidth="560"
        MinHeight="560"
        Background="{DynamicResource B.Bg}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource F.Ui}"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource B.Line}">

            <!--  ============ المواقيت والتعديل ============  -->
            <TabItem Header="المواقيت">
                <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.SectionTitle}" Text="طريقة الحساب" />

                        <ComboBox x:Name="MethodBox"
                                  SelectionChanged="OnMethodChanged"
                                  Style="{StaticResource Combo.Base}" />

                        <TextBlock x:Name="MethodNote"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource T.Faint}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource T.Dim}" Text="زاوية الفجر (درجة)" />
                                <TextBox x:Name="FajrAngleBox"
                                         Margin="0,6,0,0"
                                         HorizontalAlignment="Right"
                                         Style="{StaticResource Input.Number}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="IshaAngleLabel"
                                           Style="{StaticResource T.Dim}"
                                           Text="زاوية العشاء (درجة)" />
                                <TextBox x:Name="IshaAngleBox"
                                         Margin="0,6,0,0"
                                         HorizontalAlignment="Right"
                                         Style="{StaticResource Input.Number}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource T.Dim}" Text="مذهب العصر" />
                            <ComboBox x:Name="AsrBox"
                                      Margin="0,6,0,0"
                                      Width="240"
                                      HorizontalAlignment="Right"
                                      Style="{StaticResource Combo.Base}">
                                <ComboBoxItem Content="شافعي / مالكي / حنبلي — ظل المثل" />
                                <ComboBoxItem Content="حنفي — ظل المثلين" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1"
                                Margin="0,22"
                                Background="{DynamicResource B.Line}" />

                        <TextBlock Style="{StaticResource T.SectionTitle}"
                                   Text="تعديل دقائق كل صلاة" />
                        <TextBlock Margin="0,-6,0,12"
                                   Style="{StaticResource T.Faint}"
                                   Text="إن اختلف الوقت عن تقويم مسجدك، صحّحه هنا بالدقائق (موجب يؤخّر، سالب يقدّم)."
                                   TextWrapping="Wrap" />

                        <ItemsControl x:Name="OffsetsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource T.Base}"
                                                   Text="{Binding Name}" />

                                        <TextBlock Grid.Column="1"
                                                   Width="70"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   Style="{StaticResource T.Numeric}"
                                                   Text="{Binding ComputedTime}" />

                                        <TextBlock Grid.Column="2"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource T.Faint}"
                                                   Text="{Binding OffsetLabel}" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Click="OnOffsetDown"
                                                    Content="&#xE949;"
                                                    Style="{StaticResource Btn.Icon}"
                                                    Tag="{Binding}"
                                                    ToolTip="تقديم دقيقة" />
                                            <TextBlock Width="42"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource T.Numeric}"
                                                       Text="{Binding OffsetText}"
                                                       TextAlignment="Center" />
                                            <Button Click="OnOffsetUp"
                                                    Content="&#xE948;"
                                                    Style="{StaticResource Btn.Icon}"
                                                    Tag="{Binding}"
                                                    ToolTip="تأخير دقيقة" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ============ الأذان والإقامة ============  -->
            <TabItem Header="الأذان والإقامة">
                <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.SectionTitle}" Text="لكل صلاة على حدة" />

                        <ItemsControl x:Name="PrayerAudioList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,5"
                                            Padding="14,12"
                                            Background="{DynamicResource B.Surface}"
                                            BorderBrush="{DynamicResource B.Line}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource B.Gold}"
                                                           Style="{StaticResource T.Base}"
                                                           Text="{Binding Name}" />
                                                <CheckBox HorizontalAlignment="Left"
                                                          Content="تشغيل الأذان"
                                                          IsChecked="{Binding AdhanEnabled}"
                                                          Style="{StaticResource Check.Base}" />
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource T.Dim}"
                                                           Text="صوت الأذان" />

                                                <ComboBox Grid.Column="1"
                                                          Margin="10,0"
                                                          ItemsSource="{Binding AdhanChoices}"
                                                          SelectedItem="{Binding AdhanSound}"
                                                          Style="{StaticResource Combo.Base}" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Click="OnPreviewAdhan"
                                                            Content="&#xE768;"
                                                            Style="{StaticResource Btn.Icon}"
                                                            Tag="{Binding}"
                                                            ToolTip="تجربة" />
                                                    <Button Click="OnBrowseAdhan"
                                                            Content="&#xE8DA;"
                                                            Style="{StaticResource Btn.Icon}"
                                                            Tag="{Binding}"
                                                            ToolTip="اختيار ملف من الجهاز" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          Content="الإقامة بعد"
                                                          IsChecked="{Binding IqamaEnabled}"
                                                          Style="{StaticResource Check.Base}" />

                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0"
                                                            Orientation="Horizontal">
                                                    <Button Click="OnIqamaDown"
                                                            Content="&#xE949;"
                                                            Style="{StaticResource Btn.Icon}"
                                                            Tag="{Binding}" />
                                                    <TextBlock Width="66"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource T.Numeric}"
                                                               Text="{Binding IqamaText}"
                                                               TextAlignment="Center" />
                                                    <Button Click="OnIqamaUp"
                                                            Content="&#xE948;"
                                                            Style="{StaticResource Btn.Icon}"
                                                            Tag="{Binding}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource T.Dim}"
                                                               Text="دقيقة" />
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Click="OnPreviewIqama"
                                                        Content="&#xE768;"
                                                        Style="{StaticResource Btn.Icon}"
                                                        Tag="{Binding}"
                                                        ToolTip="تجربة الإقامة" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1"
                                Margin="0,18"
                                Background="{DynamicResource B.Line}" />

                        <TextBlock Style="{StaticResource T.SectionTitle}" Text="مستوى الصوت العام" />
                        <Grid>
                            <Slider x:Name="VolumeSlider"
                                    Margin="0,0,60,0"
                                    Maximum="1"
                                    Minimum="0"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="VolumeText"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource T.Numeric}" />
                        </Grid>

                        <Button Margin="0,14,0,0"
                                HorizontalAlignment="Right"
                                Click="OnStopPreview"
                                Content="إيقاف التجربة"
                                Style="{StaticResource Btn.Danger}" />

                        <TextBlock Margin="0,14,0,0"
                                   Style="{StaticResource T.Faint}"
                                   TextWrapping="Wrap">
                            <Run Text="لإضافة أصواتك: ضع ملفات MP3 في المجلد" />
                            <Hyperlink Click="OnOpenAudioFolder" Foreground="{DynamicResource B.Gold}">
                                <Run Text="audio" />
                            </Hyperlink>
                            <Run Text="داخل مجلد بيانات التطبيق، أو اختر أي ملف بزر المجلد أعلاه." />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ============ الموقع ============  -->
            <TabItem Header="الموقع">
                <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.SectionTitle}" Text="إحداثيات الحساب" />

                        <TextBlock Style="{StaticResource T.Dim}" Text="اسم الموقع" />
                        <TextBox x:Name="LocationNameBox"
                                 Margin="0,6,0,14"
                                 Style="{StaticResource Input.Base}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource T.Dim}" Text="خط العرض" />
                                <TextBox x:Name="LatBox"
                                         Margin="0,6,0,0"
                                         Width="Auto"
                                         Style="{StaticResource Input.Number}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource T.Dim}" Text="خط الطول" />
                                <TextBox x:Name="LngBox"
                                         Margin="0,6,0,0"
                                         Width="Auto"
                                         Style="{StaticResource Input.Number}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource T.Dim}" Text="الارتفاع (م)" />
                                <TextBox x:Name="ElevBox"
                                         Margin="0,6,0,0"
                                         Width="Auto"
                                         Style="{StaticResource Input.Number}" />
                            </StackPanel>
                        </Grid>

                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Right"
                                Click="OnResetLocation"
                                Content="العودة إلى بوشر، مسقط"
                                Style="{StaticResource Btn.Base}" />

                        <TextBlock Margin="0,20,0,0"
                                   Style="{StaticResource T.Faint}"
                                   TextWrapping="Wrap"
                                   Text="المنطقة الزمنية تُقرأ من الموقع. الافتراضي Asia/Muscat وهي بلا توقيت صيفي." />

                        <TextBlock x:Name="TimeZoneWarning"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource B.Danger}"
                                   Style="{StaticResource T.Base}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ============ عام ============  -->
            <TabItem Header="عام">
                <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.SectionTitle}" Text="المظهر" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource T.Dim}"
                                       Text="السمة" />
                            <ComboBox x:Name="ThemeBox"
                                      Width="160"
                                      Margin="12,0,0,0"
                                      Style="{StaticResource Combo.Base}">
                                <ComboBoxItem Content="ليلية" />
                                <ComboBoxItem Content="نهارية" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="ArabicDigitsCheck"
                                  Margin="0,14,0,0"
                                  Content="عرض الأرقام بالصيغة العربية الهندية (٠١٢٣)"
                                  Style="{StaticResource Check.Base}" />

                        <CheckBox x:Name="PopupCheck"
                                  Content="إظهار بطاقة الأذان وعدّاد الإقامة"
                                  Style="{StaticResource Check.Base}" />

                        <CheckBox x:Name="MiniBarCheck"
                                  Content="إظهار الشريط المصغّر فوق شريط المهام"
                                  Style="{StaticResource Check.Base}" />

                        <TextBlock Margin="24,-2,0,4"
                                   Style="{StaticResource T.Faint}"
                                   TextWrapping="Wrap"
                                   Text="يعرض الوقت المتبقي للإقامة أو للأذان القادم. انقره لفتح النافذة، والنقر الأيمن يوقف الصوت أو يُخفي الشريط." />

                        <CheckBox x:Name="PinMiniBarCheck"
                                  Margin="24,4,0,0"
                                  Content="تثبيته داخل شريط المهام بجوار الساعة"
                                  Style="{StaticResource Check.Base}" />

                        <TextBlock Margin="48,-2,0,6"
                                   Style="{StaticResource T.Faint}"
                                   TextWrapping="Wrap"
                                   Text="عند التثبيت يتبع شريط المهام تلقائيًا ولا يُسحب. أزل العلامة لتحصل على نافذة صغيرة حرّة تضعها حيث تشاء." />

                        <Button Margin="24,0,0,8"
                                HorizontalAlignment="Right"
                                Click="OnResetMiniBar"
                                Content="إعادة الشريط إلى موضعه الافتراضي"
                                Style="{StaticResource Btn.Base}" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource T.Dim}"
                                       Text="تصحيح التاريخ الهجري (أيام)" />
                            <Button Click="OnHijriDown"
                                    Content="&#xE949;"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource Btn.Icon}" />
                            <TextBlock x:Name="HijriOffsetText"
                                       Width="42"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource T.Numeric}"
                                       TextAlignment="Center" />
                            <Button Click="OnHijriUp"
                                    Content="&#xE948;"
                                    Style="{StaticResource Btn.Icon}" />
                        </StackPanel>

                        <Border Height="1"
                                Margin="0,20"
                                Background="{DynamicResource B.Line}" />

                        <TextBlock Style="{StaticResource T.SectionTitle}" Text="التشغيل والاستمرارية" />

                        <CheckBox x:Name="AutoStartCheck"
                                  Content="بدء التشغيل تلقائيًا مع ويندز"
                                  Style="{StaticResource Check.Base}" />

                        <TextBlock x:Name="AutoStartWarning"
                                   Margin="24,0,0,8"
                                   Foreground="{DynamicResource B.Danger}"
                                   Style="{StaticResource T.Base}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <CheckBox x:Name="StartMinimizedCheck"
                                  Content="البدء مخفيًا في شريط المهام"
                                  Style="{StaticResource Check.Base}" />

                        <CheckBox x:Name="HideOnCloseCheck"
                                  Content="زر الإغلاق يُخفي التطبيق بدل إنهائه"
                                  Style="{StaticResource Check.Base}" />

                        <CheckBox x:Name="KeepAwakeCheck"
                                  Content="منع الجهاز من النوم أثناء تشغيل الأذان"
                                  Style="{StaticResource Check.Base}" />

                        <Border Height="1"
                                Margin="0,20"
                                Background="{DynamicResource B.Line}" />

                        <TextBlock Style="{StaticResource T.SectionTitle}" Text="رمز الخروج" />

                        <CheckBox x:Name="RequirePinCheck"
                                  Content="طلب رمز عند إنهاء التطبيق"
                                  Style="{StaticResource Check.Base}" />

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Click="OnSetPin"
                                    Content="تعيين / تغيير الرمز"
                                    Style="{StaticResource Btn.Base}" />
                            <Button Margin="10,0,0,0"
                                    Click="OnClearPin"
                                    Content="إزالة الرمز"
                                    Style="{StaticResource Btn.Danger}" />
                        </StackPanel>

                        <TextBlock x:Name="PinStatus"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource T.Faint}"
                                   TextWrapping="Wrap" />

                        <Border Height="1"
                                Margin="0,20"
                                Background="{DynamicResource B.Line}" />

                        <TextBlock Style="{StaticResource T.SectionTitle}" Text="التسامح مع فوات الوقت" />
                        <TextBlock Margin="0,-6,0,10"
                                   Style="{StaticResource T.Faint}"
                                   TextWrapping="Wrap"
                                   Text="إذا كان الجهاز نائمًا وقت الأذان، يُشغَّل عند الاستيقاظ إن لم يمضِ أكثر من هذه المدة؛ وإلا يُسجَّل فائتًا بلا صوت." />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource T.Dim}"
                                       Text="أقصى تأخير للأذان (دقائق)" />
                            <TextBox x:Name="ToleranceBox"
                                     Margin="12,0,0,0"
                                     Style="{StaticResource Input.Number}" />
                        </StackPanel>

                        <StackPanel Margin="0,22,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Click="OnOpenLogs"
                                    Content="فتح مجلد السجلات"
                                    Style="{StaticResource Btn.Base}" />
                            <Button x:Name="BtnAbout"
                                    Margin="10,0,0,0"
                                    Click="OnShowAbout"
                                    Content="عن التطبيق"
                                    Style="{StaticResource Btn.Base}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--  ============ أزرار الحفظ ============  -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <TextBlock x:Name="SaveHint"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource T.Faint}" />

            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button Click="OnSaveClick"
                        Content="حفظ وتطبيق"
                        Style="{StaticResource Btn.Primary}" />
                <Button Margin="10,0,0,0"
                        Click="OnCloseClick"
                        Content="إغلاق"
                        Style="{StaticResource Btn.Base}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="PrayTime.App.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="رمز الحماية"
        Width="360"
        SizeToContent="Height"
        Background="{DynamicResource B.Bg}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource F.Ui}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <Border Padding="26,22"
            Background="{DynamicResource B.Surface}"
            BorderBrush="{DynamicResource B.Line}"
            BorderThickness="1"
            CornerRadius="16">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Gold}"
                       Style="{StaticResource T.Base}"
                       Text="أدخل رمز الخروج" />

            <TextBlock x:Name="HintText"
                       Margin="0,8,0,0"
                       Style="{StaticResource T.Dim}"
                       Text="لإنهاء التطبيق نهائيًا."
                       TextWrapping="Wrap" />

            <PasswordBox x:Name="Pin1"
                         Margin="0,18,0,0"
                         Padding="12,9"
                         Background="{DynamicResource B.SurfaceAlt}"
                         BorderBrush="{DynamicResource B.Line}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource B.Gold}"
                         FlowDirection="LeftToRight"
                         FontSize="20"
                         Foreground="{DynamicResource B.Text}"
                         MaxLength="12"
                         PreviewTextInput="OnDigitsOnly"
                         KeyDown="OnPinKeyDown" />

            <PasswordBox x:Name="Pin2"
                         Margin="0,10,0,0"
                         Padding="12,9"
                         Background="{DynamicResource B.SurfaceAlt}"
                         BorderBrush="{DynamicResource B.Line}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource B.Gold}"
                         FlowDirection="LeftToRight"
                         FontSize="20"
                         Foreground="{DynamicResource B.Text}"
                         MaxLength="12"
                         PreviewTextInput="OnDigitsOnly"
                         KeyDown="OnPinKeyDown"
                         Visibility="Collapsed" />

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       Foreground="{DynamicResource B.Danger}"
                       Style="{StaticResource T.Base}"
                       FontSize="13"
                       Text=""
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnOk"
                        Grid.Column="0"
                        Click="OnOkClick"
                        Content="تأكيد"
                        IsDefault="True"
                        Style="{StaticResource Btn.Primary}" />

                <Button Grid.Column="2"
                        Click="OnCancelClick"
                        Content="إلغاء"
                        IsCancel="True"
                        Style="{StaticResource Btn.Base}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="PrayTime.App.Views.AdhanPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="أذان"
        Width="360"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource F.Ui}"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">

    <Border Margin="12"
            Padding="24,20"
            Background="{DynamicResource B.Surface}"
            BorderBrush="{DynamicResource B.Gold}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Opacity="0.55"
                              ShadowDepth="4"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Foreground="{DynamicResource B.Gold}"
                           Text="&#xE8D6;" />
                <TextBlock x:Name="HeaderText"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource B.Gold}"
                           Style="{StaticResource T.Base}"
                           Text="أذان الظهر" />
            </StackPanel>

            <TextBlock x:Name="SubText"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource T.Dim}"
                       Text="حان الآن وقت الصلاة" />

            <TextBlock x:Name="BigText"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Center"
                       FontSize="40"
                       FontWeight="SemiBold"
                       Style="{StaticResource T.Numeric}"
                       Text="12:02" />

            <TextBlock x:Name="CaptionText"
                       Margin="0,2,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource T.Faint}"
                       Text="" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnStop"
                        Grid.Column="0"
                        Click="OnStopClick"
                        Content="إيقاف الصوت"
                        Style="{StaticResource Btn.Primary}" />

                <Button Grid.Column="2"
                        Click="OnDismissClick"
                        Content="إخفاء"
                        Style="{StaticResource Btn.Base}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>

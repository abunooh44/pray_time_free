<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ليلي: كحلي عميق مع ذهب هادئ. هذه هي السمة الافتراضية.  -->

    <Color x:Key="C.Bg">#070C16</Color>
    <Color x:Key="C.BgTop">#0E1727</Color>
    <Color x:Key="C.Surface">#131E32</Color>
    <Color x:Key="C.SurfaceAlt">#18253C</Color>
    <Color x:Key="C.Line">#26344F</Color>
    <Color x:Key="C.Text">#EEF3FB</Color>
    <Color x:Key="C.TextDim">#93A3BE</Color>
    <Color x:Key="C.TextFaint">#5F6F8C</Color>
    <Color x:Key="C.Gold">#E9C46A</Color>
    <Color x:Key="C.GoldDeep">#C9A227</Color>
    <Color x:Key="C.Teal">#4FBFA8</Color>
    <Color x:Key="C.Danger">#E2665C</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{DynamicResource C.Bg}" />
    <SolidColorBrush x:Key="B.Surface" Color="{DynamicResource C.Surface}" />
    <SolidColorBrush x:Key="B.SurfaceAlt" Color="{DynamicResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="B.Line" Color="{DynamicResource C.Line}" />
    <SolidColorBrush x:Key="B.Text" Color="{DynamicResource C.Text}" />
    <SolidColorBrush x:Key="B.TextDim" Color="{DynamicResource C.TextDim}" />
    <SolidColorBrush x:Key="B.TextFaint" Color="{DynamicResource C.TextFaint}" />
    <SolidColorBrush x:Key="B.Gold" Color="{DynamicResource C.Gold}" />
    <SolidColorBrush x:Key="B.GoldDeep" Color="{DynamicResource C.GoldDeep}" />
    <SolidColorBrush x:Key="B.Teal" Color="{DynamicResource C.Teal}" />
    <SolidColorBrush x:Key="B.Danger" Color="{DynamicResource C.Danger}" />

    <LinearGradientBrush x:Key="B.AppBackdrop" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="{DynamicResource C.BgTop}" />
        <GradientStop Offset="1" Color="{DynamicResource C.Bg}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.GoldSweep" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{DynamicResource C.GoldDeep}" />
        <GradientStop Offset="1" Color="{DynamicResource C.Gold}" />
    </LinearGradientBrush>

</ResourceDictionary>
